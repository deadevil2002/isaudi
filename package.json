{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build && npm run strip:source-maps",
    "cf:deploy": "wrangler deploy --config ./wrangler.toml",
    "strip:source-maps": "find .open-next/assets -type f -name '*.map' -delete",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && npm run d1:release:remote && npm run cf:deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:release:admin": "wrangler d1 execute isaudi-db --remote --config ./wrangler.toml --yes --file ./migrations/0009_admin_portal.sql",
    "d1:release:chat": "wrangler d1 execute isaudi-db --remote --config ./wrangler.toml --yes --file ./migrations/0010_ai_chat_rate_limits.sql",
    "d1:release:usage": "wrangler d1 execute isaudi-db --remote --config ./wrangler.toml --yes --file ./migrations/0011_ai_usage_ledger.sql",
    "d1:verify:release": "wrangler d1 execute isaudi-db --remote --config ./wrangler.toml --yes --command \"SELECT (SELECT COUNT(*) FROM admin_accounts) AS admin_accounts_count, (SELECT COUNT(*) FROM ai_chat_rate_limits) AS ai_chat_rate_limits_count, (SELECT COUNT(*) FROM ai_usage_ledger) AS ai_usage_ledger_count\"",
    "d1:release:remote": "npm run d1:release:admin && npm run d1:release:chat && npm run d1:release:usage && npm run d1:verify:release",
    "d1:migrate:list:remote": "wrangler d1 migrations list isaudi-db --remote",
    "release": "npm test && npx tsc --noEmit --pretty false && npm run deploy"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "framer-motion": "^12.34.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.4.0",
    "@opennextjs/cloudflare": "1.20.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "4.130.0"
  }
}
