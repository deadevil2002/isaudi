{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build && node scripts/prepare-cloudflare-assets.mjs",
    "cf:preflight:production": "node scripts/assert-cloudflare-account.mjs production",
    "cf:preflight:staging:create": "node scripts/assert-cloudflare-account.mjs staging-create",
    "cf:preflight:staging:deploy": "node scripts/assert-cloudflare-account.mjs staging-deploy",
    "cf:preflight:staging": "node scripts/assert-cloudflare-account.mjs staging",
    "cf:deploy": "npm run cf:preflight:production && wrangler deploy --config ./wrangler.toml --profile isaudi",
    "strip:source-maps": "node scripts/prepare-cloudflare-assets.mjs",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:release:rehearse": "node scripts/rehearse-production-release.mjs",
    "d1:release:production:plan": "node scripts/production-release.mjs --mode production --plan",
    "d1:release:production:execute": "node scripts/production-release.mjs --mode production --execute",
    "d1:migrate:list:remote": "wrangler d1 migrations list isaudi-db --remote --config ./wrangler.toml --profile isaudi"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "framer-motion": "^12.34.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.4.0",
    "@opennextjs/cloudflare": "1.20.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "4.130.0"
  }
}
